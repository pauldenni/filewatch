{
  "compilerOptions": {
    "inlineSourceMap": true,
    "inlineSources": true,
    "module": "Node16",
    "target": "ES6",
    "allowSyntheticDefaultImports": true,
    "importHelpers": true,
    "lib": ["ES6", "DOM"],
    "moduleResolution": "node16",
    "strict": true,
    "typeRoots": ["./node_modules/@types"]
  },
  "include": ["**/*.ts"]
}
